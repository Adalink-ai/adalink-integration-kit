{
  "name": "@adaflow/mcp",
  "version": "0.1.3",
  "description": "Servidor MCP oficial da plataforma Adaflow — expõe especialistas, agentes autônomos, chat, repositórios de conhecimento, governança e billing como tools para Claude e outros clientes MCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adalink-ai/adalink-integration-kit.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "adaflow-mcp": "./dist/index.js"
  },
  "exports": {
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/remote.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@adaflow/sdk": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.0",
    "vitest": "^3.1.0"
  }
}
